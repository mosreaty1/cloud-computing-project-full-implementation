# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ENVIRONMENT=dev

# AWS Credentials (use IAM roles in production)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# VPC Configuration
VPC_CIDR=10.0.0.0/16

# Database Configuration
DB_USERNAME=dbadmin
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=learning_platform

# Kafka Configuration
KAFKA_BROKER_COUNT=3
KAFKA_REPLICATION_FACTOR=2
KAFKA_RETENTION_MS=604800000  # 7 days
ZOOKEEPER_NODE_COUNT=3

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# JWT Configuration
JWT_SECRET=CHANGE_ME_SECURE_JWT_SECRET
JWT_EXPIRY=86400  # 24 hours

# S3 Bucket Names
TTS_BUCKET=tts-service-storage-${ENVIRONMENT}
STT_BUCKET=stt-service-storage-${ENVIRONMENT}
CHAT_BUCKET=chat-service-storage-${ENVIRONMENT}
DOCUMENT_BUCKET=document-reader-storage-${ENVIRONMENT}
QUIZ_BUCKET=quiz-service-storage-${ENVIRONMENT}
SHARED_BUCKET=shared-assets-${ENVIRONMENT}

# RDS Configuration
TTS_DB_NAME=tts_service_db
STT_DB_NAME=stt_service_db
CHAT_DB_NAME=chat_service_db
DOCUMENT_DB_NAME=document_service_db
QUIZ_DB_NAME=quiz_service_db

# Container Registry
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# Service Ports
TTS_SERVICE_PORT=8001
STT_SERVICE_PORT=8002
CHAT_SERVICE_PORT=8003
DOCUMENT_SERVICE_PORT=8004
QUIZ_SERVICE_PORT=8005
API_GATEWAY_PORT=8000

# Redis (optional cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_AUDIO_CLEANUP=true
AUDIO_RETENTION_DAYS=7
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
